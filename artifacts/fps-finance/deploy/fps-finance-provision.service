# /etc/systemd/system/fps-finance-provision.service
# Runs the idempotent, checksummed Finance provisioning before a release starts.

[Unit]
Description=Provision FPS Finance database
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=fps-finance
Group=fps-finance
WorkingDirectory=/opt/fps-finance/current
# Installed temporarily by the deploy script and removed after this invocation.
EnvironmentFile=/run/fps-finance/provision.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --enable-source-maps /opt/fps-finance/current/dist/finance-database.mjs provision
# The + prefix makes only this cleanup command run as root.
ExecStopPost=+/usr/bin/rm -f /run/fps-finance/provision.env

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/fps-finance
# ProtectSystem also affects ExecStopPost. This narrow exception lets only the
# root-prefixed cleanup remove the credential file; the directory is root:root
# mode 0700, so the postgres process still cannot access it directly.
ReadWritePaths=/run/fps-finance
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes