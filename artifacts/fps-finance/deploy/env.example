# /etc/fps-finance/runtime.env — EXAMPLE FILE (placeholder values only)
# ---------------------------------------------------------------
# Copy this file to /etc/fps-finance/runtime.env on FINANCE_VPS_01.
# Owner: root:fps-finance   Mode: 0640
#
#   sudo install -o root -g fps-finance -m 0640 /dev/null /etc/fps-finance/runtime.env
#   sudo nano /etc/fps-finance/runtime.env
#
# NEVER commit real credentials to this repository.
# ---------------------------------------------------------------

# ---- Database ----
# Loopback PostgreSQL connection for the Finance-only fps_finance database.
# DB user: fps_finance_app. Finance reads ONLY this variable and never falls back
# to DATABASE_URL. Replit secrets do NOT transfer to this VPS, so this value
# must be set here even though it is also configured in Replit for development.
FINANCE_DATABASE_URL=postgresql://fps_finance_app:CHANGE_ME@127.0.0.1:5432/fps_finance

# ---- Session secret ----
# Minimum 64 random bytes, base64 or hex encoded.
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# This value MUST persist across deployments so existing sessions survive a restart.
FINANCE_SESSION_SECRET=CHANGE_ME_use_64_random_bytes

# ---- MFA encryption ----
# Base64 of exactly 32 random bytes. Preserve this independently of the VPS.
FINANCE_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# ---- Public URL and Microsoft Graph invitation mail ----
FINANCE_PUBLIC_URL=https://finance.futurholding.com
FINANCE_GRAPH_TENANT_ID=CHANGE_ME
FINANCE_GRAPH_CLIENT_ID=CHANGE_ME
FINANCE_GRAPH_CLIENT_SECRET=CHANGE_ME
FINANCE_GRAPH_SENDER=control@futurholding.com

# ---- Optional first administrator invitation ----
# FINANCE_BOOTSTRAP_EMAIL=CHANGE_ME
# FINANCE_BOOTSTRAP_ROLES=finance_admin

# ---- Connect sync (optional until the snapshot endpoint is configured) ----
# URL of the upstream Connect API used for master-data synchronisation.
FINANCE_CONNECT_SYNC_URL=https://connect.futurholding.com/CHANGE_ME
FINANCE_CONNECT_SYNC_TOKEN=CHANGE_ME

# ---- Logging ----
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Optional overrides (values set by systemd unit take precedence) ----
# NODE_ENV=production
# PORT=22044
# BASE_PATH=/
